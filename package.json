{
  "name": "shashka-arena",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "start": "node server/src/index.js",
    "db:generate": "npm run prisma:generate --prefix server",
    "db:migrate": "npm run prisma:migrate --prefix server",
    "db:deploy": "npm run prisma:deploy --prefix server",
    "db:push": "npm run prisma:push --prefix server",
    "make-admin": "npm run make-admin --prefix server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}